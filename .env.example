# ShareInference configuration. Copy to .env (git-ignored) and fill the required values.
# Never commit .env. Docker Compose reads it; the api container receives only the variables it uses.

# Which compose profiles start. `localdb` starts the bundled Postgres 17 (volume db-data).
# Optional. Leave empty when DATABASE_URL points at an external Postgres.
COMPOSE_PROFILES=localdb

# Password of the bundled Postgres (user and database: shareinference).
# Required with the localdb profile; empty makes the db container refuse to start.
# Generate: openssl rand -hex 16   (hex only: avoid `$` and other special characters).
# Postgres fixes it when the volume is first created; changing it later needs `docker compose down -v` (deletes data).
POSTGRES_PASSWORD=

# Postgres connection URL used by the api (postgres:// or postgresql://). Required.
# Bundled db: compose interpolates ${POSTGRES_PASSWORD}, but `pnpm dev` (Node's --env-file) does not: write the
# password itself here when you use `pnpm dev`. A password with `@`, `/` or `:` must be
# percent-encoded here.
# External/managed Postgres (e.g. GCP Cloud SQL): use its URL with sslmode=verify-full. node-postgres verifies the
# server certificate for sslmode=require as well, so the provider's CA must be trusted.
# Host depends on where the api runs: `127.0.0.1` for `pnpm dev` (api on your machine), `db` for the full compose
# stack (`docker compose up`, and production).
DATABASE_URL=postgres://shareinference:${POSTGRES_PASSWORD}@db:5432/shareinference

# Max connections in the api's pool, 2 or more (migrations need two). Optional, default 10.
# DB_POOL_MAX=10

# Host ports and bind address of the web and api (compose only; the app never reads them). Optional.
# BIND_ADDR is the host address the ports are published on; default 127.0.0.1 (loopback only). Set it to the VM's
# NIC address (e.g. 10.0.2.15) only when the stack runs inside a VM with NAT port forwarding from the host.
# Never use 0.0.0.0 on a public machine. The db port stays on 127.0.0.1 regardless.
# BIND_ADDR=127.0.0.1
# WEB_PORT=4400
# API_PORT=4401

# Public origin of the web app (cookies, redirects): http(s)://host[:port], no path or trailing slash. Required.
WEB_ORIGIN=http://localhost:4400

# Public origin of the api (consumers, provider WebSocket): same format. Required. Production: its own host,
# https://api.shareinference.com.
API_PUBLIC_URL=http://localhost:4401

# Trust the X-Real-IP header for per-IP rate limits: true | false. Optional, default false (the socket address).
# Set true ONLY behind the production reverse proxy (Caddy), which overwrites the header on every request; with
# direct access a client could otherwise fake its address.
# TRUST_PROXY=false

# Production only (compose.prod.yaml, docs/deploy.md; compose only, the app never reads them):
# DOMAIN is the public host of the website and API_DOMAIN the host of the api (api.shareinference.com); Caddy serves
# both and gets their certificates. Locally: DOMAIN=localhost, API_DOMAIN=api.localhost.
# HTTP_PORT / HTTPS_PORT are the host ports Caddy publishes (default 80 / 443). IMAGE_TAG selects the prebuilt images
# (scripts/deploy.mjs writes it to .deploy.env on the server; default `latest` for development builds).
# DOMAIN=shareinference.com
# API_DOMAIN=api.shareinference.com
# HTTP_PORT=80
# HTTPS_PORT=443

# Port the api listens on. Optional; default 4000 (the container; compose publishes it). `pnpm dev` uses 4401.
# PORT=

# Log level: debug | info | warn | error. Optional, default info.
# LOG_LEVEL=info

# Postgres URL for the api tests (a separate, empty database; tests skip when unset). Optional, host-only.
# Example: postgres://shareinference:<POSTGRES_PASSWORD>@127.0.0.1:5432/shareinference_test
# TEST_DATABASE_URL=

# GitHub OAuth app credentials (sign-in). Required. Create the app on GitHub:
#   Settings -> Developer settings -> OAuth Apps -> New OAuth App
#   Homepage URL:               the same value as WEB_ORIGIN
#   Authorization callback URL: <WEB_ORIGIN>/api/auth/github/callback
# then copy the Client ID here and generate a client secret. Never commit the secret.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Credits granted to every new user at sign-up (a `grant` ledger entry). Integer >= 0. Optional, default 0.
# SIGNUP_GRANT_CREDITS=0

# Deploy target for `pnpm run deploy` (scripts/deploy.mjs), e.g. root@<vm-address>; not read by the app.
# Optional: DEPLOY_DIR, DEPLOY_DOMAIN, DEPLOY_API_DOMAIN, DEPLOY_PLATFORM, DEPLOY_SSH_OPTS, DEPLOY_CURL_OPTS (see the script header).
DEPLOY_HOST=
